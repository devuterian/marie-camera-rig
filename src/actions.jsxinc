    function buildOrUpdateRig() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return null;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            camera = createCamera(comp);
        }

        var controller = findControllerForCamera(comp, camera);
        var foreign = hasForeignExpressions(camera);

        if (!controller && foreign.length > 0) {
            var message = "이 카메라에 기존 표현식이 있어:\n\n" +
                foreign.join(", ") +
                "\n\n키프레임과 기본값은 그대로 쓰지만, 이 표현식들은 MCR 표현식으로 바뀌어. " +
                "원본은 컨트롤러 Comment에 백업되고 리그를 지울 때 다시 돌아와. 계속할까?";
            if (!confirm(message)) return null;
        }

        app.beginUndoGroup(SCRIPT_NAME + " - 리그 만들기 / 새로고침");
        try {
            if (!controller) controller = createController(comp, camera);
            ensureControllerEffects(controller, camera, comp);
            backupExpressions(controller, camera);
            applyExpressions(camera, controller);

            controller.selected = true;
            camera.selected = false;
            comp.hideShyLayers = false;
            return controller;
        } catch (err) {
            alertError("리그를 만드는 중에 문제가 생겼어:\n" + err.toString());
            return null;
        } finally {
            app.endUndoGroup();
        }
    }

    function createTarget(slot) {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }

        var controller = findControllerForCamera(comp, camera);
        if (!controller) controller = buildOrUpdateRig();
        if (!controller) return;

        app.beginUndoGroup(SCRIPT_NAME + " - 타깃 만들기");
        try {
            var target = comp.layers.addShape();
            target.name = TARGET_PREFIX + (slot === "A" ? "A" : "B");
            target.guideLayer = true;
            target.threeDLayer = true;
            target.label = 11;
            addTargetArtwork(target);

            var transform = camera.property("ADBE Transform Group");
            var position;
            try {
                position = transform.property("ADBE Anchor Point").valueAtTime(comp.time, false);
                if (!position || position.length < 3) throw new Error("No POI");
            } catch (e) {
                position = [comp.width / 2, comp.height / 2, 0];
            }
            target.property("ADBE Transform Group").property("ADBE Position").setValue(position);
            target.moveBefore(controller);

            setEffectValue(controller, slot === "A" ? FX.TARGET_A : FX.TARGET_B, target.index);
            setEffectValue(controller, FX.AUTO_AIM, 1);
            setEffectValue(controller, FX.AUTO_FOCUS, 1);

            target.selected = true;
            controller.selected = false;
            camera.selected = false;
        } catch (err) {
            alertError("타깃을 만드는 중에 문제가 생겼어:\n" + err.toString());
        } finally {
            app.endUndoGroup();
        }
    }

    function addImpactMarker() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }

        var controller = findControllerForCamera(comp, camera);
        if (!controller) controller = buildOrUpdateRig();
        if (!controller) return;

        app.beginUndoGroup(SCRIPT_NAME + " - 충격 추가");
        try {
            var marker = new MarkerValue("MCR_IMPACT");
            marker.label = 9;
            controller.property("ADBE Marker").setValueAtTime(comp.time, marker);
            controller.selected = true;
            camera.selected = false;
        } catch (err) {
            alertError("충격을 추가하는 중에 문제가 생겼어:\n" + err.toString());
        } finally {
            app.endUndoGroup();
        }
    }

    function applyPreset(index) {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }

        var controller = findControllerForCamera(comp, camera);
        if (!controller) controller = buildOrUpdateRig();
        if (!controller) return;

        app.beginUndoGroup(SCRIPT_NAME + " - 흔들림 프리셋");
        try {
            setEffectValue(controller, FX.SHAKE_PRESET, index);
            if (index > 1) {
                setEffectValue(controller, FX.SHAKE_INTENSITY, 100);
                setEffectValue(controller, FX.SHAKE_SPEED, 100);
            }
            controller.selected = true;
            camera.selected = false;
        } finally {
            app.endUndoGroup();
        }
    }


    function copyBakeValue(value) {
        if (value instanceof Array) return value.slice(0);
        return value;
    }

    function isMcrExpression(prop) {
        if (!prop || !prop.canSetExpression || !prop.expressionEnabled) return false;
        try {
            return prop.expression && prop.expression.indexOf("// MCR ") >= 0;
        } catch (e) {
            return false;
        }
    }

    function getBakeProperties(camera) {
        var map = cameraPropertyMap(camera);
        var props = [];
        var position = map.position;

        if (position.dimensionsSeparated) {
            if (isMcrExpression(map.xPosition)) props.push(map.xPosition);
            if (isMcrExpression(map.yPosition)) props.push(map.yPosition);
            if (isMcrExpression(map.zPosition)) props.push(map.zPosition);
        } else if (isMcrExpression(position)) {
            props.push(position);
        }

        if (isMcrExpression(map.pointOfInterest)) props.push(map.pointOfInterest);
        if (isMcrExpression(map.orientation)) props.push(map.orientation);
        if (isMcrExpression(map.xRotation)) props.push(map.xRotation);
        if (isMcrExpression(map.yRotation)) props.push(map.yRotation);
        if (isMcrExpression(map.zRotation)) props.push(map.zRotation);
        if (isMcrExpression(map.zoom)) props.push(map.zoom);
        if (isMcrExpression(map.depthOfField)) props.push(map.depthOfField);
        if (isMcrExpression(map.focusDistance)) props.push(map.focusDistance);
        if (isMcrExpression(map.aperture)) props.push(map.aperture);
        if (isMcrExpression(map.blurLevel)) props.push(map.blurLevel);

        return props;
    }

    function removeKeysInRange(prop, startTime, endTime) {
        var i;
        for (i = prop.numKeys; i >= 1; i--) {
            var keyTime = prop.keyTime(i);
            if (keyTime >= startTime - 0.000001 && keyTime < endTime - 0.000001) {
                prop.removeKey(i);
            }
        }
    }

    function bakeRig() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }

        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return;
        }

        var startTime = comp.workAreaStart;
        var duration = comp.workAreaDuration;
        var frameDuration = comp.frameDuration;

        if (duration < frameDuration) {
            alertError("작업 영역이 너무 짧아. 한 프레임 이상 잡아줘.");
            return;
        }

        var frameCount = Math.max(1, Math.floor(duration / frameDuration + 0.0001));
        var endTime = startTime + frameCount * frameDuration;
        var message =
            "작업 영역 " + frameCount + "프레임을 실제 키프레임으로 구울게.\n\n" +
            "MCR 컨트롤은 지워지고, 카메라에는 프레임마다 키가 생겨. " +
            "마음에 안 들면 바로 Undo 하면 돼. 계속할까?";
        if (!confirm(message)) return;

        app.beginUndoGroup(SCRIPT_NAME + " - 키프레임으로 Bake");
        try {
            var props = getBakeProperties(camera);
            if (props.length < 1) {
                alertError("구울 MCR 표현식이 없어.");
                return;
            }

            var times = [];
            var valuesByProp = [];
            var i, p, t;

            for (i = 0; i < frameCount; i++) {
                times.push(startTime + i * frameDuration);
            }

            for (p = 0; p < props.length; p++) {
                var values = [];
                for (i = 0; i < times.length; i++) {
                    t = times[i];
                    values.push(copyBakeValue(props[p].valueAtTime(t, false)));
                }
                valuesByProp.push(values);
            }

            for (p = 0; p < props.length; p++) {
                props[p].expression = "";
                removeKeysInRange(props[p], startTime, endTime);
                props[p].setValuesAtTimes(times, valuesByProp[p]);
            }

            controller.remove();

            var layerIndex;
            for (layerIndex = 1; layerIndex <= comp.numLayers; layerIndex++) {
                comp.layer(layerIndex).selected = false;
            }
            camera.selected = true;

            alert("Bake 끝!\n작업 영역 " + frameCount + "프레임을 카메라 키로 바꿨어.");
        } catch (err) {
            alertError("Bake 하는 중에 문제가 생겼어:\n" + err.toString());
        } finally {
            app.endUndoGroup();
        }
    }

    function resetControls() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }

        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return;
        }

        app.beginUndoGroup(SCRIPT_NAME + " - 값 초기화");
        try {
            setEffectValue(controller, FX.ENABLE, 1);
            setEffectValue(controller, FX.OFFSET_SPACE, 1);
            setEffectValue(controller, FX.POSITION, [0, 0, 0]);
            setEffectValue(controller, FX.ROT_X, 0);
            setEffectValue(controller, FX.ROT_Y, 0);
            setEffectValue(controller, FX.ROT_Z, 0);
            setEffectValue(controller, FX.TARGET_BLEND, 0);
            setEffectValue(controller, FX.AUTO_AIM, 0);
            setEffectValue(controller, FX.AUTO_FOCUS, 0);
            setEffectValue(controller, FX.FOCUS_OFFSET, 0);
            setEffectValue(controller, FX.DRIFT_ENABLE, 0);
            setEffectValue(controller, FX.SHAKE_PRESET, 1);
            setEffectValue(controller, FX.SHAKE_INTENSITY, 100);
            setEffectValue(controller, FX.SHAKE_SPEED, 100);
            setEffectValue(controller, FX.ZOOM_OFFSET, 0);
            setEffectValue(controller, FX.LENS_ENABLE, 0);
        } finally {
            app.endUndoGroup();
        }
    }

    function restoreExpression(prop, expression) {
        if (!prop || !prop.canSetExpression) return;
        try {
            prop.expression = expression || "";
        } catch (e) {}
    }

    function removeRig() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }

        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return;
        }

        if (!confirm("MCR 리그를 지울까?\n백업해 둔 기존 표현식이 있으면 같이 돌아와.")) return;

        app.beginUndoGroup(SCRIPT_NAME + " - 리그 지우기");
        try {
            var backup = readBackup(controller);
            var map = cameraPropertyMap(camera);

            restoreExpression(map.position, backup.position);
            restoreExpression(map.xPosition, backup.xPosition);
            restoreExpression(map.yPosition, backup.yPosition);
            restoreExpression(map.zPosition, backup.zPosition);
            restoreExpression(map.pointOfInterest, backup.pointOfInterest);
            restoreExpression(map.orientation, backup.orientation);
            restoreExpression(map.xRotation, backup.xRotation);
            restoreExpression(map.yRotation, backup.yRotation);
            restoreExpression(map.zRotation, backup.zRotation);
            restoreExpression(map.zoom, backup.zoom);
            restoreExpression(map.depthOfField, backup.depthOfField);
            restoreExpression(map.focusDistance, backup.focusDistance);
            restoreExpression(map.aperture, backup.aperture);
            restoreExpression(map.blurLevel, backup.blurLevel);

            controller.remove();
            camera.selected = true;
        } catch (err) {
            alertError("리그를 지우는 중에 문제가 생겼어:\n" + err.toString());
        } finally {
            app.endUndoGroup();
        }
    }

    function selectCamera() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }
        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }
        var i;
        for (i = 1; i <= comp.numLayers; i++) comp.layer(i).selected = false;
        camera.selected = true;
    }

    function selectController() {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }
        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return;
        }
        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return;
        }
        var i;
        for (i = 1; i <= comp.numLayers; i++) comp.layer(i).selected = false;
        controller.selected = true;
    }

    function setSelectedLayerAsTarget(slot) {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return;
        }

        var selected = comp.selectedLayers;
        if (selected.length < 1) {
            alertError("타깃으로 쓸 레이어를 하나 골라줘.");
            return;
        }

        var target = selected[0];
        var camera = null;
        var controller = null;
        var i;

        for (i = 0; i < selected.length; i++) {
            if (isCamera(selected[i])) camera = selected[i];
            var c = findCameraForController(comp, selected[i]);
            if (c) {
                camera = c;
                controller = selected[i];
            }
        }

        if (!camera) camera = comp.activeCamera;
        if (!camera || !isCamera(camera)) {
            alertError("지금 쓸 수 있는 카메라가 없어.");
            return;
        }

        if (target === camera || target === controller) {
            alertError("카메라나 MCR 컨트롤 자체는 타깃으로 쓸 수 없어.");
            return;
        }

        if (!controller) controller = findControllerForCamera(comp, camera);
        if (!controller) controller = buildOrUpdateRig();
        if (!controller) return;

        app.beginUndoGroup(SCRIPT_NAME + " - 타깃 지정");
        try {
            setEffectValue(controller, slot === "A" ? FX.TARGET_A : FX.TARGET_B, target.index);
            setEffectValue(controller, FX.AUTO_AIM, 1);
        } finally {
            app.endUndoGroup();
        }
    }

