/*
marierie Camera Rig
After Effects 2020+용 카메라 리그
MIT License

만든 방향:
- null을 여러 개 쌓지 않고 Shape Layer 컨트롤러 하나로 정리한다.
- 카메라에 이미 찍힌 키프레임과 기본값을 그대로 두고 오프셋만 더한다.
- 타깃 전환, 자동 조준, 자동 초점, 렌즈, 드리프트, 흔들림, 충격을 한곳에서 다룬다.
- 패널에서 만들기, 새로고침, Bake, 초기화, 제거까지 끝낼 수 있게 한다.
- 기존 표현식은 컨트롤러 Comment에 백업하고 리그 제거 시 되돌린다.
*/

(function marierieCameraRig(thisObj) {
    var SCRIPT_NAME = "marierie Camera Rig";
    var VERSION = "1.1.0";
    var SIG = "// MCR " + VERSION;
    var CTRL_PREFIX = "[MCR] ";
    var TARGET_PREFIX = "[MCR 타깃] ";

    var FX = {
        CAMERA: "MCR | 카메라",
        ENABLE: "MCR | 리그 켜기",
        OFFSET_SPACE: "MCR | 이동 기준",
        POSITION: "MCR | 위치 더하기",
        ROT_X: "MCR | 회전 X",
        ROT_Y: "MCR | 회전 Y",
        ROT_Z: "MCR | 회전 Z",

        TARGET_A: "MCR | 타깃 A",
        TARGET_B: "MCR | 타깃 B",
        TARGET_BLEND: "MCR | 타깃 섞기",
        AUTO_AIM: "MCR | 타깃 바라보기",
        AUTO_FOCUS: "MCR | 자동 초점",
        FOCUS_OFFSET: "MCR | 초점 보정",
        MANUAL_FOCUS: "MCR | 직접 초점 거리",

        DRIFT_ENABLE: "MCR | 느린 흔들림",
        DRIFT_POS: "MCR | 느린 위치 흔들림",
        DRIFT_ROT: "MCR | 느린 회전 흔들림",
        DRIFT_SPEED: "MCR | 느린 흔들림 속도",
        DRIFT_SEED: "MCR | 느린 흔들림 시드",

        SHAKE_PRESET: "MCR | 흔들림 프리셋",
        SHAKE_INTENSITY: "MCR | 흔들림 세기",
        SHAKE_SPEED: "MCR | 흔들림 속도",
        SHAKE_SEED: "MCR | 흔들림 시드",
        CUSTOM_POS: "MCR | 직접 위치 흔들림",
        CUSTOM_ROT: "MCR | 직접 회전 흔들림",
        CUSTOM_FREQ: "MCR | 직접 흔들림 빈도",

        IMPACT_POS: "MCR | 충격 위치",
        IMPACT_ROT: "MCR | 충격 회전",
        IMPACT_DECAY: "MCR | 충격 감쇠",
        IMPACT_FREQ: "MCR | 충격 진동수",

        LENS_ENABLE: "MCR | 렌즈 직접 설정",
        FOCAL_LENGTH: "MCR | 초점 거리 (mm)",
        ZOOM_OFFSET: "MCR | 줌 보정",
        DOF_ENABLE: "MCR | 심도 켜기",
        APERTURE: "MCR | 조리개",
        BLUR_LEVEL: "MCR | 블러 양"
    };

    function alertError(message) {
        alert(SCRIPT_NAME + "\n\n" + message);
    }

    function isComp(item) {
        return item && item instanceof CompItem;
    }

    function getActiveComp() {
        var item = app.project.activeItem;
        return isComp(item) ? item : null;
    }

    function isCamera(layer) {
        return layer && layer instanceof CameraLayer;
    }

    function escExpressionString(value) {
        return String(value)
            .replace(/\\/g, "\\\\")
            .replace(/"/g, '\\"')
            .replace(/\r/g, "\\r")
            .replace(/\n/g, "\\n");
    }

    function effectGroup(layer) {
        return layer.property("ADBE Effect Parade");
    }

    function getEffect(layer, name) {
        if (!layer) return null;
        var parade = effectGroup(layer);
        return parade ? parade.property(name) : null;
    }

    function effectValue(layer, name, fallback) {
        try {
            var fx = getEffect(layer, name);
            return fx ? fx.property(1).value : fallback;
        } catch (e) {
            return fallback;
        }
    }

    function setEffectValue(layer, name, value) {
        var fx = getEffect(layer, name);
        if (!fx) return false;
        try {
            fx.property(1).setValue(value);
            return true;
        } catch (e) {
            return false;
        }
    }

    function addEffect(layer, matchName, name, defaultValue, menuItems) {
        var existing = getEffect(layer, name);
        if (existing) return existing;

        var parade = effectGroup(layer);
        if (!parade || !parade.canAddProperty(matchName)) {
            throw new Error("Cannot add effect: " + name + " (" + matchName + ")");
        }

        var fx = parade.addProperty(matchName);
        fx.name = name;

        if (menuItems && matchName === "ADBE Dropdown Control") {
            var menuProp = fx.property(1);
            menuProp = menuProp.setPropertyParameters(menuItems);
            if (defaultValue !== undefined && defaultValue !== null) {
                menuProp.setValue(defaultValue);
            }
        } else if (defaultValue !== undefined && defaultValue !== null) {
            fx.property(1).setValue(defaultValue);
        }

        return fx;
    }

    function ensureControllerEffects(controller, camera, comp) {
        var camOptions = camera.property("ADBE Camera Options Group");
        var zoom = camOptions.property("ADBE Camera Zoom").value;
        var focus = camOptions.property("ADBE Camera Focus Distance").value;
        var aperture = camOptions.property("ADBE Camera Aperture").value;
        var blur = camOptions.property("ADBE Camera Blur Level").value;
        var focal = Math.max(1, zoom * 36.0 / comp.width);

        addEffect(controller, "ADBE Layer Control", FX.CAMERA, camera.index);
        setEffectValue(controller, FX.CAMERA, camera.index);

        addEffect(controller, "ADBE Checkbox Control", FX.ENABLE, 1);
        addEffect(controller, "ADBE Dropdown Control", FX.OFFSET_SPACE, 1, [
            "월드",
            "카메라 기준"
        ]);
        addEffect(controller, "ADBE Point3D Control", FX.POSITION, [0, 0, 0]);
        addEffect(controller, "ADBE Angle Control", FX.ROT_X, 0);
        addEffect(controller, "ADBE Angle Control", FX.ROT_Y, 0);
        addEffect(controller, "ADBE Angle Control", FX.ROT_Z, 0);

        addEffect(controller, "ADBE Layer Control", FX.TARGET_A, 0);
        addEffect(controller, "ADBE Layer Control", FX.TARGET_B, 0);
        addEffect(controller, "ADBE Slider Control", FX.TARGET_BLEND, 0);
        addEffect(controller, "ADBE Checkbox Control", FX.AUTO_AIM, 0);
        addEffect(controller, "ADBE Checkbox Control", FX.AUTO_FOCUS, 0);
        addEffect(controller, "ADBE Slider Control", FX.FOCUS_OFFSET, 0);
        addEffect(controller, "ADBE Slider Control", FX.MANUAL_FOCUS, focus);

        addEffect(controller, "ADBE Checkbox Control", FX.DRIFT_ENABLE, 0);
        addEffect(controller, "ADBE Point3D Control", FX.DRIFT_POS, [15, 10, 5]);
        addEffect(controller, "ADBE Point3D Control", FX.DRIFT_ROT, [0.25, 0.2, 0.15]);
        addEffect(controller, "ADBE Slider Control", FX.DRIFT_SPEED, 0.35);
        addEffect(controller, "ADBE Slider Control", FX.DRIFT_SEED, 1);

        addEffect(controller, "ADBE Dropdown Control", FX.SHAKE_PRESET, 1, [
            "없음",
            "은은하게",
            "핸드헬드",
            "강하게",
            "지진",
            "직접 설정"
        ]);
        addEffect(controller, "ADBE Slider Control", FX.SHAKE_INTENSITY, 100);
        addEffect(controller, "ADBE Slider Control", FX.SHAKE_SPEED, 100);
        addEffect(controller, "ADBE Slider Control", FX.SHAKE_SEED, 1);
        addEffect(controller, "ADBE Point3D Control", FX.CUSTOM_POS, [25, 18, 8]);
        addEffect(controller, "ADBE Point3D Control", FX.CUSTOM_ROT, [0.7, 0.55, 0.45]);
        addEffect(controller, "ADBE Slider Control", FX.CUSTOM_FREQ, 2.5);

        addEffect(controller, "ADBE Point3D Control", FX.IMPACT_POS, [75, 55, 20]);
        addEffect(controller, "ADBE Point3D Control", FX.IMPACT_ROT, [1.8, 1.4, 2.2]);
        addEffect(controller, "ADBE Slider Control", FX.IMPACT_DECAY, 6);
        addEffect(controller, "ADBE Slider Control", FX.IMPACT_FREQ, 7);

        addEffect(controller, "ADBE Checkbox Control", FX.LENS_ENABLE, 0);
        addEffect(controller, "ADBE Slider Control", FX.FOCAL_LENGTH, focal);
        addEffect(controller, "ADBE Slider Control", FX.ZOOM_OFFSET, 0);
        addEffect(controller, "ADBE Checkbox Control", FX.DOF_ENABLE,
            camOptions.property("ADBE Camera Depth of Field").value ? 1 : 0);
        addEffect(controller, "ADBE Slider Control", FX.APERTURE, aperture);
        addEffect(controller, "ADBE Slider Control", FX.BLUR_LEVEL, blur);
    }

