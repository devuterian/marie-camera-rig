    function targetFunction(ctrlName) {
        return [
            'function mcrTargetPos(ctrl) {',
            '  var aIndex = Math.round(ctrl.effect("' + FX.TARGET_A + '")(1));',
            '  var bIndex = Math.round(ctrl.effect("' + FX.TARGET_B + '")(1));',
            '  var mix = clamp(ctrl.effect("' + FX.TARGET_BLEND + '")(1) / 100, 0, 1);',
            '  var hasA = aIndex > 0 && aIndex <= thisComp.numLayers;',
            '  var hasB = bIndex > 0 && bIndex <= thisComp.numLayers;',
            '  if (!hasA && !hasB) return null;',
            '  if (hasA) { var a = thisComp.layer(aIndex); var pa = a.toWorld(a.anchorPoint); }',
            '  if (hasB) { var b = thisComp.layer(bIndex); var pb = b.toWorld(b.anchorPoint); }',
            '  if (hasA && hasB) return pa + (pb - pa) * mix;',
            '  return hasA ? pa : pb;',
            '}'
        ].join("\n");
    }

    function motionFunctions() {
        return [
            'function mcrNoise(t, seed, axis) {',
            '  var a = noise(t + seed * 17.123 + axis * 31.731);',
            '  var b = noise(t * 2.173 + seed * 9.417 + axis * 57.119);',
            '  return a * 0.72 + b * 0.28;',
            '}',
            'function mcrPresetPos(preset) {',
            '  if (preset == 2) return [5, 3, 1.5];',
            '  if (preset == 3) return [18, 12, 5];',
            '  if (preset == 4) return [45, 30, 14];',
            '  if (preset == 5) return [95, 75, 28];',
            '  return [0, 0, 0];',
            '}',
            'function mcrPresetRot(preset) {',
            '  if (preset == 2) return [0.15, 0.12, 0.10];',
            '  if (preset == 3) return [0.50, 0.38, 0.32];',
            '  if (preset == 4) return [1.30, 1.00, 1.15];',
            '  if (preset == 5) return [2.40, 1.90, 2.80];',
            '  return [0, 0, 0];',
            '}',
            'function mcrPresetFreq(preset) {',
            '  if (preset == 2) return 0.65;',
            '  if (preset == 3) return 1.80;',
            '  if (preset == 4) return 4.50;',
            '  if (preset == 5) return 7.50;',
            '  return 0;',
            '}',
            'function mcrImpact(ctrl, amp, axis) {',
            '  var total = 0;',
            '  var decay = Math.max(0.01, ctrl.effect("' + FX.IMPACT_DECAY + '")(1));',
            '  var freq = Math.max(0.01, ctrl.effect("' + FX.IMPACT_FREQ + '")(1));',
            '  for (var i = 1; i <= ctrl.marker.numKeys; i++) {',
            '    var mk = ctrl.marker.key(i);',
            '    if (mk.comment == "MCR_IMPACT") {',
            '      var dt = time - mk.time;',
            '      if (dt >= 0 && dt <= 2.5) {',
            '        total += amp * Math.sin(dt * freq * Math.PI * 2 + axis * 1.73) * Math.exp(-dt * decay);',
            '      }',
            '    }',
            '  }',
            '  return total;',
            '}'
        ].join("\n");
    }

    function positionExpression(controller, axis) {
        var ctrlName = escExpressionString(controller.name);
        var lines = [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5) { value; } else {',
            motionFunctions(),
            '    var manual = ctrl.effect("' + FX.POSITION + '")(1);',
            '    var total = [manual[0], manual[1], manual[2]];',
            '    if (ctrl.effect("' + FX.DRIFT_ENABLE + '")(1) >= 0.5) {',
            '      var driftAmp = ctrl.effect("' + FX.DRIFT_POS + '")(1);',
            '      var driftSpeed = Math.max(0, ctrl.effect("' + FX.DRIFT_SPEED + '")(1));',
            '      var driftSeed = ctrl.effect("' + FX.DRIFT_SEED + '")(1);',
            '      for (var d = 0; d < 3; d++) total[d] += driftAmp[d] * mcrNoise(time * driftSpeed, driftSeed, d);',
            '    }',
            '    var preset = Math.round(ctrl.effect("' + FX.SHAKE_PRESET + '")(1));',
            '    if (preset > 1) {',
            '      var intensity = Math.max(0, ctrl.effect("' + FX.SHAKE_INTENSITY + '")(1)) / 100;',
            '      var speed = Math.max(0, ctrl.effect("' + FX.SHAKE_SPEED + '")(1)) / 100;',
            '      var seed = ctrl.effect("' + FX.SHAKE_SEED + '")(1);',
            '      var amp = preset == 6 ? ctrl.effect("' + FX.CUSTOM_POS + '")(1) : mcrPresetPos(preset);',
            '      var freq = preset == 6 ? Math.max(0, ctrl.effect("' + FX.CUSTOM_FREQ + '")(1)) : mcrPresetFreq(preset);',
            '      for (var s = 0; s < 3; s++) total[s] += amp[s] * intensity * mcrNoise(time * freq * speed, seed, s + 10);',
            '    }',
            '    var impactAmp = ctrl.effect("' + FX.IMPACT_POS + '")(1);',
            '    for (var q = 0; q < 3; q++) total[q] += mcrImpact(ctrl, impactAmp[q], q + 20);',
            '    var deltaWorld;',
            '    if (Math.round(ctrl.effect("' + FX.OFFSET_SPACE + '")(1)) == 2) deltaWorld = toWorldVec(total);',
            '    else deltaWorld = total;',
            '    var delta = thisLayer.hasParent ? parent.fromWorldVec(deltaWorld) : deltaWorld;'
        ];

        if (axis === null || axis === undefined) {
            lines.push('    value + delta;');
        } else {
            lines.push('    value + delta[' + axis + '];');
        }
        lines.push('  }', '} catch (err) { value; }');
        return lines.join("\n");
    }

    function rotationExpression(controller, axis, effectName) {
        var ctrlName = escExpressionString(controller.name);
        return [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5) { value; } else {',
            motionFunctions(),
            '    var total = ctrl.effect("' + effectName + '")(1);',
            '    if (ctrl.effect("' + FX.DRIFT_ENABLE + '")(1) >= 0.5) {',
            '      var driftAmp = ctrl.effect("' + FX.DRIFT_ROT + '")(1);',
            '      var driftSpeed = Math.max(0, ctrl.effect("' + FX.DRIFT_SPEED + '")(1));',
            '      var driftSeed = ctrl.effect("' + FX.DRIFT_SEED + '")(1);',
            '      total += driftAmp[' + axis + '] * mcrNoise(time * driftSpeed, driftSeed, ' + (axis + 30) + ');',
            '    }',
            '    var preset = Math.round(ctrl.effect("' + FX.SHAKE_PRESET + '")(1));',
            '    if (preset > 1) {',
            '      var intensity = Math.max(0, ctrl.effect("' + FX.SHAKE_INTENSITY + '")(1)) / 100;',
            '      var speed = Math.max(0, ctrl.effect("' + FX.SHAKE_SPEED + '")(1)) / 100;',
            '      var seed = ctrl.effect("' + FX.SHAKE_SEED + '")(1);',
            '      var amp = preset == 6 ? ctrl.effect("' + FX.CUSTOM_ROT + '")(1) : mcrPresetRot(preset);',
            '      var freq = preset == 6 ? Math.max(0, ctrl.effect("' + FX.CUSTOM_FREQ + '")(1)) : mcrPresetFreq(preset);',
            '      total += amp[' + axis + '] * intensity * mcrNoise(time * freq * speed, seed, ' + (axis + 40) + ');',
            '    }',
            '    var impactAmp = ctrl.effect("' + FX.IMPACT_ROT + '")(1);',
            '    total += mcrImpact(ctrl, impactAmp[' + axis + '], ' + (axis + 50) + ');',
            '    value + total;',
            '  }',
            '} catch (err) { value; }'
        ].join("\n");
    }

    function pointOfInterestExpression(controller) {
        var ctrlName = escExpressionString(controller.name);
        return [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            targetFunction(ctrlName),
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5 || ctrl.effect("' + FX.AUTO_AIM + '")(1) < 0.5) value;',
            '  else { var p = mcrTargetPos(ctrl); p == null ? value : p; }',
            '} catch (err) { value; }'
        ].join("\n");
    }

    function orientationExpression(controller) {
        var ctrlName = escExpressionString(controller.name);
        return [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            targetFunction(ctrlName),
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5 || ctrl.effect("' + FX.AUTO_AIM + '")(1) < 0.5) value;',
            '  else {',
            '    var p = mcrTargetPos(ctrl);',
            '    p == null ? value : lookAt(toWorld([0,0,0]), p);',
            '  }',
            '} catch (err) { value; }'
        ].join("\n");
    }

    function zoomExpression(controller) {
        var ctrlName = escExpressionString(controller.name);
        return [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5) value;',
            '  else {',
            '    var zoff = ctrl.effect("' + FX.ZOOM_OFFSET + '")(1);',
            '    if (ctrl.effect("' + FX.LENS_ENABLE + '")(1) >= 0.5) {',
            '      var focal = Math.max(0.1, ctrl.effect("' + FX.FOCAL_LENGTH + '")(1));',
            '      Math.max(1, thisComp.width * focal / 36 + zoff);',
            '    } else Math.max(1, value + zoff);',
            '  }',
            '} catch (err) { value; }'
        ].join("\n");
    }

    function focusExpression(controller) {
        var ctrlName = escExpressionString(controller.name);
        return [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            targetFunction(ctrlName),
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5) value;',
            '  else {',
            '    var offset = ctrl.effect("' + FX.FOCUS_OFFSET + '")(1);',
            '    if (ctrl.effect("' + FX.AUTO_FOCUS + '")(1) >= 0.5) {',
            '      var p = mcrTargetPos(ctrl);',
            '      if (p == null) Math.max(0.1, ctrl.effect("' + FX.MANUAL_FOCUS + '")(1) + offset);',
            '      else {',
            '        var v1 = p - toWorld([0,0,0]);',
            '        var v2 = toWorldVec([0,0,1]);',
            '        Math.max(0.1, dot(v1, v2) + offset);',
            '      }',
            '    } else Math.max(0.1, ctrl.effect("' + FX.MANUAL_FOCUS + '")(1) + offset);',
            '  }',
            '} catch (err) { value; }'
        ].join("\n");
    }

    function directControlExpression(controller, effectName, minimum) {
        var ctrlName = escExpressionString(controller.name);
        var valueLine = minimum !== null && minimum !== undefined
            ? 'Math.max(' + minimum + ', ctrl.effect("' + effectName + '")(1));'
            : 'ctrl.effect("' + effectName + '")(1);';
        return [
            SIG,
            'try {',
            '  var ctrl = thisComp.layer("' + ctrlName + '");',
            '  if (ctrl.effect("' + FX.ENABLE + '")(1) < 0.5) value;',
            '  else ' + valueLine,
            '} catch (err) { value; }'
        ].join("\n");
    }

    function applyExpressions(camera, controller) {
        var map = cameraPropertyMap(camera);
        var position = map.position;

        if (position.dimensionsSeparated) {
            map.xPosition.expression = positionExpression(controller, 0);
            map.yPosition.expression = positionExpression(controller, 1);
            map.zPosition.expression = positionExpression(controller, 2);
            if (position.expressionEnabled && position.expression.indexOf("// MCR ") >= 0) {
                position.expression = "";
            }
        } else {
            position.expression = positionExpression(controller, null);
        }

        map.xRotation.expression = rotationExpression(controller, 0, FX.ROT_X);
        map.yRotation.expression = rotationExpression(controller, 1, FX.ROT_Y);
        map.zRotation.expression = rotationExpression(controller, 2, FX.ROT_Z);

        var isTwoNode = false;
        try {
            isTwoNode = camera.autoOrient === AutoOrientType.CAMERA_OR_POINT_OF_INTEREST;
        } catch (e) {}

        if (isTwoNode) {
            map.pointOfInterest.expression = pointOfInterestExpression(controller);
        } else {
            map.orientation.expression = orientationExpression(controller);
        }

        map.zoom.expression = zoomExpression(controller);
        map.depthOfField.expression = directControlExpression(controller, FX.DOF_ENABLE, null);
        map.focusDistance.expression = focusExpression(controller);
        map.aperture.expression = directControlExpression(controller, FX.APERTURE, 0);
        map.blurLevel.expression = directControlExpression(controller, FX.BLUR_LEVEL, 0);
    }

