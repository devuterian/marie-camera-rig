    // v1.2.0 안정화 패치. PR #2의 기능은 유지하고 위험한 덮어쓰기만 막는다.
    VERSION = "1.2.0";
    SIG = "// MCR " + VERSION;

    function mcrSelectOnly(comp, layer) {
        var i;
        for (i = 1; i <= comp.numLayers; i++) comp.layer(i).selected = false;
        if (layer) layer.selected = true;
    }

    function mcrHas(object, key) {
        return object && typeof object[key] !== "undefined";
    }

    function mcrControlledLayer(comp, controller, effectName) {
        var fx = getEffect(controller, effectName);
        if (!fx) return null;
        try {
            var index = Math.round(fx.property(1).value);
            return index > 0 && index <= comp.numLayers ? comp.layer(index) : null;
        } catch (e) {
            return null;
        }
    }

    function mcrRemoveOwnedTargets(comp, controller) {
        var targets = [
            mcrControlledLayer(comp, controller, FX.TARGET_A),
            mcrControlledLayer(comp, controller, FX.TARGET_B)
        ];
        var i, target;
        for (i = 0; i < targets.length; i++) {
            target = targets[i];
            if (!target) continue;
            try {
                if (target.guideLayer && target.name.indexOf(TARGET_PREFIX) === 0) target.remove();
            } catch (e) {}
        }
    }

    function mcrClearImpactMarkers(controller) {
        var markers = controller.property("ADBE Marker");
        if (!markers) return;
        var i;
        for (i = markers.numKeys; i >= 1; i--) {
            try {
                if (markers.keyValue(i).comment === "MCR_IMPACT") markers.removeKey(i);
            } catch (e) {}
        }
    }

    propExpression = function (prop) {
        if (!prop || !prop.canSetExpression) return "";
        try {
            return prop.expression || "";
        } catch (e) {
            return "";
        }
    };

    function mcrExpressionEnabled(prop) {
        if (!prop || !prop.canSetExpression) return "0";
        try {
            return prop.expressionEnabled ? "1" : "0";
        } catch (e) {
            return "0";
        }
    }

    backupExpressions = function (controller, camera) {
        if (controller.comment && controller.comment.indexOf("MCR_BACKUP_BEGIN") >= 0) return;

        var map = cameraPropertyMap(camera);
        var keys = [
            "position", "xPosition", "yPosition", "zPosition",
            "pointOfInterest", "orientation",
            "xRotation", "yRotation", "zRotation",
            "zoom", "depthOfField", "focusDistance", "aperture", "blurLevel"
        ];
        var lines = ["MCR_BACKUP_BEGIN", "version=" + VERSION];
        var i, key;
        lines.push("posSeparated=" + map.posSeparated);
        lines.push("autoOrient=" + encode(map.autoOrient));
        for (i = 0; i < keys.length; i++) {
            key = keys[i];
            lines.push(key + "=" + encode(propExpression(map[key])));
            lines.push(key + "Enabled=" + mcrExpressionEnabled(map[key]));
        }
        lines.push("MCR_BACKUP_END");
        controller.comment = (controller.comment ? controller.comment + "\n" : "") + lines.join("\n");
    };

    hasForeignExpressions = function (camera) {
        var map = cameraPropertyMap(camera);
        var keys = [
            "position", "xPosition", "yPosition", "zPosition",
            "pointOfInterest", "orientation",
            "xRotation", "yRotation", "zRotation",
            "zoom", "depthOfField", "focusDistance", "aperture", "blurLevel"
        ];
        var foreign = [];
        var i, expression;
        for (i = 0; i < keys.length; i++) {
            if (!map[keys[i]]) continue;
            expression = propExpression(map[keys[i]]);
            if (expression && expression.indexOf("// MCR ") < 0) foreign.push(keys[i]);
        }
        return foreign;
    };

    buildOrUpdateRig = function () {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return null;
        }

        var camera = getCameraFromContext(comp);
        var controller = camera ? findControllerForCamera(comp, camera) : null;
        var foreign = camera ? hasForeignExpressions(camera) : [];

        if (controller && foreign.length > 0) {
            alertError(
                "MCR을 붙인 뒤 추가된 다른 표현식이 있어 새로고침을 멈췄어.\n\n" +
                foreign.join(", ") +
                "\n\n리그 지우기로 원래 표현식을 복원한 다음 다시 연결해줘."
            );
            return null;
        }

        if (!controller && foreign.length > 0) {
            var message = "이 카메라에 기존 표현식이 있어:\n\n" +
                foreign.join(", ") +
                "\n\nMCR이 해당 표현식을 교체하지만 원본과 켜짐 상태는 컨트롤 레이어에 백업해. " +
                "리그 지우기를 누르면 다시 복원돼. 계속할까?";
            if (!confirm(message)) return null;
        }

        app.beginUndoGroup(SCRIPT_NAME + " - 리그 만들기 / 새로고침");
        try {
            if (!camera) camera = createCamera(comp);
            if (!controller) controller = createController(comp, camera);
            ensureControllerEffects(controller, camera, comp);
            backupExpressions(controller, camera);
            applyExpressions(camera, controller);
            mcrSelectOnly(comp, controller);
            comp.hideShyLayers = false;
            return controller;
        } catch (error) {
            alertError("리그를 만드는 중에 문제가 생겼어:\n" + error.toString());
            return null;
        } finally {
            app.endUndoGroup();
        }
    };

    function mcrCopyBakeValue(value) {
        return value instanceof Array ? value.slice(0) : value;
    }

    function mcrIsRigExpression(prop) {
        if (!prop || !prop.canSetExpression) return false;
        try {
            return prop.expression && prop.expression.indexOf("// MCR ") >= 0;
        } catch (e) {
            return false;
        }
    }

    function mcrBakeProperties(camera) {
        var map = cameraPropertyMap(camera);
        var props = [];
        if (map.position.dimensionsSeparated) {
            if (mcrIsRigExpression(map.xPosition)) props.push(map.xPosition);
            if (mcrIsRigExpression(map.yPosition)) props.push(map.yPosition);
            if (mcrIsRigExpression(map.zPosition)) props.push(map.zPosition);
        } else if (mcrIsRigExpression(map.position)) {
            props.push(map.position);
        }
        if (mcrIsRigExpression(map.pointOfInterest)) props.push(map.pointOfInterest);
        if (mcrIsRigExpression(map.orientation)) props.push(map.orientation);
        if (mcrIsRigExpression(map.xRotation)) props.push(map.xRotation);
        if (mcrIsRigExpression(map.yRotation)) props.push(map.yRotation);
        if (mcrIsRigExpression(map.zRotation)) props.push(map.zRotation);
        if (mcrIsRigExpression(map.zoom)) props.push(map.zoom);
        if (mcrIsRigExpression(map.depthOfField)) props.push(map.depthOfField);
        if (mcrIsRigExpression(map.focusDistance)) props.push(map.focusDistance);
        if (mcrIsRigExpression(map.aperture)) props.push(map.aperture);
        if (mcrIsRigExpression(map.blurLevel)) props.push(map.blurLevel);
        return props;
    }

    function mcrRemoveKeysInRange(prop, startTime, endTime) {
        var i, keyTime;
        for (i = prop.numKeys; i >= 1; i--) {
            keyTime = prop.keyTime(i);
            if (keyTime >= startTime - 0.000001 && keyTime < endTime - 0.000001) prop.removeKey(i);
        }
    }

    bakeRig = function () {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return false;
        }
        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return false;
        }
        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return false;
        }

        var frameDuration = comp.frameDuration;
        var startFrame = Math.round(comp.workAreaStart / frameDuration);
        var frameCount = Math.round(comp.workAreaDuration / frameDuration);
        if (frameCount < 1) {
            alertError("작업 영역을 한 프레임 이상 잡아줘.");
            return false;
        }
        if (frameCount > 30000) {
            alertError("작업 영역이 30,000프레임을 넘어. 구간을 나눠서 Bake해줘.");
            return false;
        }

        var startTime = startFrame * frameDuration;
        var endTime = startTime + frameCount * frameDuration;
        if (!confirm(
            "작업 영역 " + frameCount + "프레임을 실제 카메라 키로 바꿀게.\n\n" +
            "해당 구간의 기존 키는 최종 화면 값으로 교체되고 MCR 컨트롤은 지워져. " +
            "결과가 마음에 안 들면 바로 Undo 하면 돼. 계속할까?"
        )) return false;

        app.beginUndoGroup(SCRIPT_NAME + " - 작업 영역 Bake");
        try {
            var props = mcrBakeProperties(camera);
            if (props.length < 1) {
                alertError("구울 MCR 표현식이 없어.");
                return false;
            }

            var times = [];
            var valuesByProp = [];
            var i, p, values;
            for (i = 0; i < frameCount; i++) times.push(startTime + i * frameDuration);
            for (p = 0; p < props.length; p++) {
                values = [];
                for (i = 0; i < times.length; i++) {
                    values.push(mcrCopyBakeValue(props[p].valueAtTime(times[i], false)));
                }
                valuesByProp.push(values);
            }
            for (p = 0; p < props.length; p++) {
                props[p].expression = "";
                mcrRemoveKeysInRange(props[p], startTime, endTime);
                props[p].setValuesAtTimes(times, valuesByProp[p]);
            }

            mcrRemoveOwnedTargets(comp, controller);
            controller.remove();
            mcrSelectOnly(comp, camera);
            alert("Bake 끝!\n작업 영역 " + frameCount + "프레임을 카메라 키로 바꿨어.");
            return true;
        } catch (error) {
            alertError("Bake 중에 문제가 생겼어:\n" + error.toString());
            return false;
        } finally {
            app.endUndoGroup();
        }
    };

    resetControls = function () {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return false;
        }
        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return false;
        }
        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return false;
        }

        app.beginUndoGroup(SCRIPT_NAME + " - 움직임 초기화");
        try {
            setEffectValue(controller, FX.ENABLE, 1);
            setEffectValue(controller, FX.OFFSET_SPACE, 1);
            setEffectValue(controller, FX.POSITION, [0, 0, 0]);
            setEffectValue(controller, FX.ROT_X, 0);
            setEffectValue(controller, FX.ROT_Y, 0);
            setEffectValue(controller, FX.ROT_Z, 0);
            setEffectValue(controller, FX.TARGET_BLEND, 0);
            setEffectValue(controller, FX.AUTO_AIM, 0);
            setEffectValue(controller, FX.AUTO_FOCUS, 0);
            setEffectValue(controller, FX.FOCUS_OFFSET, 0);
            setEffectValue(controller, FX.DRIFT_ENABLE, 0);
            setEffectValue(controller, FX.DRIFT_POS, [15, 10, 5]);
            setEffectValue(controller, FX.DRIFT_ROT, [0.25, 0.2, 0.15]);
            setEffectValue(controller, FX.DRIFT_SPEED, 0.35);
            setEffectValue(controller, FX.DRIFT_SEED, 1);
            setEffectValue(controller, FX.SHAKE_PRESET, 1);
            setEffectValue(controller, FX.SHAKE_INTENSITY, 100);
            setEffectValue(controller, FX.SHAKE_SPEED, 100);
            setEffectValue(controller, FX.SHAKE_SEED, 1);
            setEffectValue(controller, FX.CUSTOM_POS, [25, 18, 8]);
            setEffectValue(controller, FX.CUSTOM_ROT, [0.7, 0.55, 0.45]);
            setEffectValue(controller, FX.CUSTOM_FREQ, 2.5);
            setEffectValue(controller, FX.IMPACT_POS, [75, 55, 20]);
            setEffectValue(controller, FX.IMPACT_ROT, [1.8, 1.4, 2.2]);
            setEffectValue(controller, FX.IMPACT_DECAY, 6);
            setEffectValue(controller, FX.IMPACT_FREQ, 7);
            setEffectValue(controller, FX.ZOOM_OFFSET, 0);
            setEffectValue(controller, FX.LENS_ENABLE, 0);
            mcrClearImpactMarkers(controller);
            mcrSelectOnly(comp, controller);
            return true;
        } finally {
            app.endUndoGroup();
        }
    };

    restoreExpression = function (prop, backup, key) {
        if (!prop || !prop.canSetExpression) return;
        try {
            var current = propExpression(prop);
            if (current && current.indexOf("// MCR ") < 0) return;
            if (mcrHas(backup, key)) {
                prop.expression = backup[key] || "";
                if (backup[key] && mcrHas(backup, key + "Enabled")) {
                    prop.expressionEnabled = backup[key + "Enabled"] === "1";
                }
            } else if (current.indexOf("// MCR ") >= 0) {
                prop.expression = "";
            }
        } catch (e) {}
    };

    removeRig = function () {
        var comp = getActiveComp();
        if (!comp) {
            alertError("컴포지션을 하나 열어줘.");
            return false;
        }
        var camera = getCameraFromContext(comp);
        if (!camera) {
            alertError("카메라나 MCR 컨트롤을 선택해줘.");
            return false;
        }
        var controller = findControllerForCamera(comp, camera);
        if (!controller) {
            alertError("이 카메라에는 MCR 리그가 없어.");
            return false;
        }
        if (!confirm("MCR 리그를 지울까?\n처음 연결할 때 백업한 표현식이 있으면 원래 켜짐 상태까지 복원해.")) {
            return false;
        }

        app.beginUndoGroup(SCRIPT_NAME + " - 리그 지우기");
        try {
            var backup = readBackup(controller);
            var map = cameraPropertyMap(camera);
            restoreExpression(map.position, backup, "position");
            restoreExpression(map.xPosition, backup, "xPosition");
            restoreExpression(map.yPosition, backup, "yPosition");
            restoreExpression(map.zPosition, backup, "zPosition");
            restoreExpression(map.pointOfInterest, backup, "pointOfInterest");
            restoreExpression(map.orientation, backup, "orientation");
            restoreExpression(map.xRotation, backup, "xRotation");
            restoreExpression(map.yRotation, backup, "yRotation");
            restoreExpression(map.zRotation, backup, "zRotation");
            restoreExpression(map.zoom, backup, "zoom");
            restoreExpression(map.depthOfField, backup, "depthOfField");
            restoreExpression(map.focusDistance, backup, "focusDistance");
            restoreExpression(map.aperture, backup, "aperture");
            restoreExpression(map.blurLevel, backup, "blurLevel");
            mcrRemoveOwnedTargets(comp, controller);
            controller.remove();
            mcrSelectOnly(comp, camera);
            return true;
        } catch (error) {
            alertError("리그를 지우는 중에 문제가 생겼어:\n" + error.toString());
            return false;
        } finally {
            app.endUndoGroup();
        }
    };

    selectCamera = function () {
        var comp = getActiveComp();
        if (!comp) return alertError("컴포지션을 하나 열어줘.");
        var camera = getCameraFromContext(comp);
        if (!camera) return alertError("카메라나 MCR 컨트롤을 선택해줘.");
        mcrSelectOnly(comp, camera);
        return true;
    };

    selectController = function () {
        var comp = getActiveComp();
        if (!comp) return alertError("컴포지션을 하나 열어줘.");
        var camera = getCameraFromContext(comp);
        if (!camera) return alertError("카메라나 MCR 컨트롤을 선택해줘.");
        var controller = findControllerForCamera(comp, camera);
        if (!controller) return alertError("이 카메라에는 MCR 리그가 없어.");
        mcrSelectOnly(comp, controller);
        return true;
    };

    setSelectedLayerAsTarget = function (slot) {
        var comp = getActiveComp();
        if (!comp) return alertError("컴포지션을 하나 열어줘.");
        var selected = comp.selectedLayers;
        if (selected.length < 1) return alertError("타깃으로 쓸 레이어를 하나 선택해줘.");

        var camera = getCameraFromContext(comp);
        if (!camera) return alertError("활성 카메라가 없어. 먼저 리그를 만들어줘.");
        var controller = findControllerForCamera(comp, camera);
        if (!controller) controller = buildOrUpdateRig();
        if (!controller) return false;

        var target = null;
        var i;
        for (i = 0; i < selected.length; i++) {
            if (selected[i] !== camera && selected[i] !== controller) {
                target = selected[i];
                break;
            }
        }
        if (!target) return alertError("카메라와 MCR 컨트롤 말고 타깃으로 쓸 레이어를 선택해줘.");

        app.beginUndoGroup(SCRIPT_NAME + " - 타깃 지정");
        try {
            setEffectValue(controller, slot === "A" ? FX.TARGET_A : FX.TARGET_B, target.index);
            setEffectValue(controller, FX.AUTO_AIM, 1);
            return true;
        } finally {
            app.endUndoGroup();
        }
    };
